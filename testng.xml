<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<!-- Suite level -->
<suite name="SauceDemo Suite" parallel="tests" thread-count="3">

    <!-- Global Parameters -->
    <parameter name="browser" value="chrome"/>
    <parameter name="baseUrl" value="https://www.saucedemo.com/"/>

    <!-- Test group 1 -->
    <test name="Login Tests" parallel="classes">
        <classes>
            <class name="tests.LoginTests">
                <methods>
                    <!-- Run only login-related tests -->
                    <include name="testValidLogin"/>
                    <include name="testInvalidLogin"/>
                    <include name="testLockedOutUser"/>
                    <include name="testEmptyFields"/>
                </methods>
            </class>
        </classes>
    </test>

    <!-- Test group 2 -->
    <test name="Logout Tests">
        <classes>
            <class name="tests.LoginTests">
                <methods>
                    <include name="testLogout"/>
                </methods>
            </class>
        </classes>
    </test>

    <!-- Regression group -->
    <test name="Regression Suite">
        <groups>
            <run>
                <include name="regression"/>
            </run>
        </groups>
        <classes>
            <class name="tests.CartTests"/>
            <class name="tests.CheckoutTests"/>
        </classes>
    </test>

</suite>
